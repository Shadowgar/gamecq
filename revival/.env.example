# Copy to .env and adjust before first run

TZ=UTC

# Database
MYSQL_DATABASE=darkspace
MYSQL_USER=darkspace
MYSQL_PASSWORD=darkspace_local_only
MYSQL_ROOT_PASSWORD=darkspace_root_local_only
MYSQL_PORT=3306

# Service ports (host:container)
META_PORT=9000
PROCESS_PORT=9300
MIRROR_PORT=9100
DARKSPACE_SERVER_PORT=9020
WEB_PORT=8080

# Runner image behavior
RUN_AS_UID=1000
RUN_AS_GID=1000
